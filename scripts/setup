#!/bin/bash

# Description: Copy scripts to ~/.local/bin for quick access


DIR="$HOME/.local/bin"

if [[ -d "$DIR" ]]; then
  echo "$DIR exists"
else
  echo "$DIR does not exist. Creating $DIR..."
  mkdir -p "$DIR"
  echo "$DIR created"
fi

echo "Linking scripts to $DIR..."

for script in *; do
    # Only add 
    [[ -x "$script" ]]
    ln -sf "$script" "$DIR/$script"
done

echo "Scripts successfully copied."
