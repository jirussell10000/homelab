#!/bin/bash

# Description: Checks whether a file exists. If it doesn't it will return an error (exit code: 1) If it does it will process it.


if [[ "$#" -ne 1 ]]; then
    echo "Usage: $0 <file>"
    exit 1
fi

if [[ ! -f "$1" ]]; then
    echo "File not found: $1"
    exit 1
else
    echo "$1 exists"
fi
