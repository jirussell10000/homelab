#!/bin/bash

# Loads all SSH private keys into the background authentication helper `ssh-agent`

# Creates empty array for keys successfully added to the ssh-agent
keys=()

# Check whether ssh-agent is not running nor has keys loaded
if ssh-add -l >/dev/null 2>&1; then
    status=$?
    if [[ $status -eq 2 ]]; then
        echo "ERROR: Could not connect to ssh-agent (agent is not running)">&2
        exit 2
    elif [[ $status -eq 1 ]]; then
        echo "INFO: No keys are loaded in the agent"
    else
        echo "INFO: Keys are loaded in the agent"
    fi
fi

# Change to .ssh directory
cd ~/.ssh || exit

# Add keys to ssh-agent
for file in *; do
    [[ -f "$file" ]] || continue
    [[ "$file" == known_hosts* ]] && continue
    [[ "$file" == config ]] && continue

    # If file ends with .pub skip it
    [[ ${file##*.} == "pub" ]] && continue 
  
    if ssh-keygen -l -f "$file" >/dev/null 2>&1; then 
        ssh-add "$file"
        keys+=("$file")
    fi
done

# Check if number of successfully added keys
if [[ "${#keys[@]}" -gt 0 ]]; then
    echo -e "\n${#keys[@]} keys are loaded in the agent:"
    ssh-add -l
else
    echo "No valid private keys were loaded"
fi
