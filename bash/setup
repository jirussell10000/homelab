#!/bin/bash

# Description: Copy scripts to ~/.local/bin for quick access


DIR="$HOME/.local/bin"

unsuccessful_scripts=()

if [[ -d "$DIR" ]]; then
  echo "$DIR exists"
else
  echo "$DIR does not exist. Creating $DIR..."
  mkdir -p "$DIR"
  echo "$DIR created"
fi

echo "Copying scripts to $DIR..."

for SCRIPT in *; do 
    [[ -x "$SCRIPT" ]] || continue
    cp "$SCRIPT" "$DIR/$SCRIPT"
    if [[ "$?" -ne 0 ]]; then
        echo "error: Script $SCRIPT copy unsuccessful"
        unsuccessful_scripts+=("$SCRIPT")
    else
        echo "info: Script $SCRIPT successfully copied"
    fi
done

echo "Copying scripts completed"
